<!-- 관리창 화면. csc 로만 빌드하므로 XAML 은 실행할 때 XamlReader 로 읽고, 이벤트는 App.cs 가 이름으로 찾아 붙인다.
     색은 모두 테마 키(DynamicResource) — 값은 App.cs 의 Look 팔레트가 어둡게/밝게로 넣는다. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="영웅입지전 · 모드매니저" Width="1320" Height="900" MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="{DynamicResource UiFont}" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" AllowDrop="True">
  <Window.Resources>
    <CornerRadius x:Key="BtnRadius">7</CornerRadius>
    <!-- type scale: six sizes only, set for the Windows UI font (Segoe UI / Malgun Gothic) -->
    <sys:Double x:Key="FsDisplay">22</sys:Double>   <!-- app name -->
    <sys:Double x:Key="FsTitle">17</sys:Double>     <!-- dialog titles, drop hints, busy -->
    <sys:Double x:Key="FsHeadline">15</sys:Double>  <!-- list headings, detail title, game state -->
    <sys:Double x:Key="FsBody">13</sys:Double>      <!-- body, buttons, card names (Medium) -->
    <sys:Double x:Key="FsSecondary">12</sys:Double> <!-- descriptions, versions, kinds -->
    <sys:Double x:Key="FsCaption">11.5</sys:Double> <!-- pills and tags -->
    <!-- motion: durations come from the application (Motion.Install) — all zero when Windows animation effects are off.
         One set of storyboards for every button-like template: Sc = its scale, H = hover layer, On = chosen layer.
         Hover fades a layer in (themes freeze their brushes, so a layer's opacity moves, not a colour).
         Press shrinks only the plate behind the label (Sc sits on the plate, never on the text: scaled text re-hints every frame
         and shimmers), then eases back without overshoot. -->
    <SineEase x:Key="EaseOut" EasingMode="EaseOut"/>
    <CubicEase x:Key="EaseSettle" EasingMode="EaseOut"/>
    <Storyboard x:Key="HoverIn"><DoubleAnimation Storyboard.TargetName="H" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource MotionHover}" EasingFunction="{StaticResource EaseOut}"/></Storyboard>
    <Storyboard x:Key="HoverOut"><DoubleAnimation Storyboard.TargetName="H" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource MotionHoverOut}" EasingFunction="{StaticResource EaseOut}"/></Storyboard>
    <Storyboard x:Key="OnIn"><DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource MotionFade}" EasingFunction="{StaticResource EaseOut}"/></Storyboard>
    <Storyboard x:Key="OnOut"><DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource MotionFade}" EasingFunction="{StaticResource EaseOut}"/></Storyboard>
    <Storyboard x:Key="TintIn"><DoubleAnimation Storyboard.TargetName="P" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource MotionPress}" EasingFunction="{StaticResource EaseOut}"/></Storyboard>
    <Storyboard x:Key="TintOut"><DoubleAnimation Storyboard.TargetName="P" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource MotionRelease}" EasingFunction="{StaticResource EaseSettle}"/></Storyboard>
    <Storyboard x:Key="PressIn">
      <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="0.95" Duration="{StaticResource MotionPress}" EasingFunction="{StaticResource EaseOut}"/>
      <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="0.95" Duration="{StaticResource MotionPress}" EasingFunction="{StaticResource EaseOut}"/>
    </Storyboard>
    <Storyboard x:Key="PressOut">
      <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="{StaticResource MotionRelease}" EasingFunction="{StaticResource EaseSettle}"/>
      <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="{StaticResource MotionRelease}" EasingFunction="{StaticResource EaseSettle}"/>
    </Storyboard>
    <!-- things that come and go (notice band, alerts, tags, the dragged card): fade in when they appear -->
    <Storyboard x:Key="AppearIn"><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="{StaticResource MotionFade}" EasingFunction="{StaticResource EaseOut}"/></Storyboard>
    <Style x:Key="Appear" TargetType="FrameworkElement">
      <Style.Triggers><Trigger Property="IsVisible" Value="True"><Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource AppearIn}"/></Trigger.EnterActions></Trigger></Style.Triggers>
    </Style>
    <!-- focus ring only for keyboard moves (Tab), never left behind by a mouse click -->
    <Style x:Key="FocusRing">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate><Border BorderBrush="{DynamicResource AccentLine}" BorderThickness="2" CornerRadius="9" Margin="-3"/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- buttons: quiet filled surface; Primary = accent fill (save), Tint = accent text on a soft tint (launch), Warn = reserved save -->
    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource BtnText}"/>
      <Setter Property="Background" Value="{DynamicResource BtnBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BtnLine}"/>
      <Setter Property="Padding" Value="13,6"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Root">
              <Grid x:Name="Plate" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform><ScaleTransform x:Name="Sc"/></Grid.RenderTransform>
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource BtnRadius}"/>
                <Border x:Name="H" Background="{DynamicResource BtnHover}" Margin="1" CornerRadius="{DynamicResource BtnRadius}" Opacity="0"/>
              </Grid>
              <Border x:Name="Label" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}"/></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}"/></Trigger.ExitActions></Trigger>
              <Trigger Property="IsPressed" Value="True"><Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource PressIn}"/></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource PressOut}"/></Trigger.ExitActions></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Plate" Property="Opacity" Value="0.45"/><Setter TargetName="Label" Property="Opacity" Value="0.6"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource Btn}"/>
    <!-- the column between the two lists: buttons that belong together share one rounded group (켜기|끄기, 위로|아래로),
         split by a hairline; inside a group the icons stand in one column and the labels start on one line (the label column
         is as wide as the group's longest label), and that block is centred;
         hover shows an inset plate and press deepens it, both with the group's own corner (RailRadius = the group's radius less its 2 px inset);
         nothing here shrinks: a shrinking plate inside a still frame read as a different shape -->
    <Style x:Key="RailGroup" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource BtnBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BtnLine}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{DynamicResource BtnRadius}"/>
      <Setter Property="Padding" Value="2"/>
    </Style>
    <Style x:Key="RailSplit" TargetType="Border">
      <Setter Property="Height" Value="1"/>
      <Setter Property="Margin" Value="10,0"/>
      <Setter Property="Background" Value="{DynamicResource Line}"/>
    </Style>
    <Style x:Key="RailBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Foreground" Value="{DynamicResource BtnText}"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Root" Background="Transparent">
              <Border x:Name="H" Background="{DynamicResource BtnHover}" CornerRadius="{DynamicResource RailRadius}" Opacity="0"/>
              <Border x:Name="P" Background="{DynamicResource LineStrong}" CornerRadius="{DynamicResource RailRadius}" Opacity="0"/>
              <Grid x:Name="Label" HorizontalAlignment="Center" Margin="{TemplateBinding Padding}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto" SharedSizeGroup="RailText"/></Grid.ColumnDefinitions>
                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,1,7,0" Foreground="{TemplateBinding Foreground}"/>
                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left"/>
              </Grid>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}"/></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}"/></Trigger.ExitActions></Trigger>
              <Trigger Property="IsPressed" Value="True"><Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource TintIn}"/></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource TintOut}"/></Trigger.ExitActions></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Label" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- small icon buttons (Segoe icon font): 게시글 · 패치노트 on a card and on a workshop patch line; the tooltip says what it does -->
    <Style x:Key="IconBtn" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Dim}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="2,0,0,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <Border x:Name="H" Background="{DynamicResource BtnHover}" CornerRadius="6" Opacity="0" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform x:Name="Sc"/></Border.RenderTransform></Border>
              <Border Padding="4,3"><TextBlock Text="{TemplateBinding Content}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{TemplateBinding Foreground}"/></Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}"/></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}"/></Trigger.ExitActions></Trigger>
              <Trigger Property="IsPressed" Value="True"><Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource PressIn}"/></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource PressOut}"/></Trigger.ExitActions></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
      <Setter Property="Background" Value="{DynamicResource Accent}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Root">
              <Grid x:Name="Plate" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform><ScaleTransform x:Name="Sc"/></Grid.RenderTransform>
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource BtnRadius}"/>
                <Border x:Name="H" Background="{DynamicResource AccentHover}" CornerRadius="{DynamicResource BtnRadius}" Opacity="0"/>
              </Grid>
              <Border x:Name="Label" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}"/></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}"/></Trigger.ExitActions></Trigger>
              <Trigger Property="IsPressed" Value="True"><Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource PressIn}"/></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource PressOut}"/></Trigger.ExitActions></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Plate" Property="Opacity" Value="0.45"/><Setter TargetName="Label" Property="Opacity" Value="0.6"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TintBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
      <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="WarnBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Foreground" Value="{DynamicResource Warn}"/>
      <Setter Property="Background" Value="{DynamicResource WarnSoft}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Warn}"/>
    </Style>
    <!-- segmented control (top tabs): the chosen segment is a raised chip inside a sunken track; it fades in -->
    <Style x:Key="Segment" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{DynamicResource SegText}"/>
      <Setter Property="Padding" Value="14,5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Grid x:Name="Root" Background="Transparent">
              <Border x:Name="On" Background="{DynamicResource SegmentOn}" CornerRadius="6" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform><ScaleTransform x:Name="Sc"/></Border.RenderTransform>
                <Border.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Direction="270" Opacity="0.16" Color="Black"/></Border.Effect>
              </Border>
              <Border Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource SegTextOn}"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SegTextOn}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource OnIn}"/></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource OnOut}"/></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource PressIn}"/></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource PressOut}"/></Trigger.ExitActions></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- small toggles (알림, 고급 설정, dialog tabs): text button that turns into an accent tint when on -->
    <Style x:Key="Tab" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{DynamicResource Sub}"/>
      <Setter Property="Padding" Value="11,5"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Grid x:Name="Root">
              <Grid RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform><ScaleTransform x:Name="Sc"/></Grid.RenderTransform>
                <Border x:Name="H" Background="{DynamicResource RaisedHover}" CornerRadius="{DynamicResource BtnRadius}" Opacity="0"/>
                <Border x:Name="On" Background="{DynamicResource AccentSoft}" CornerRadius="{DynamicResource BtnRadius}" Opacity="0"/>
                <Border x:Name="B" Background="Transparent" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" CornerRadius="{DynamicResource BtnRadius}"/>
              </Grid>
              <Border BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}"/></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}"/></Trigger.ExitActions></Trigger>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource OnIn}"/></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource OnOut}"/></Trigger.ExitActions></Trigger>
              <Trigger Property="IsPressed" Value="True"><Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource PressIn}"/></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource PressOut}"/></Trigger.ExitActions></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Chip" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid x:Name="Root" Background="Transparent">
              <Grid RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform><ScaleTransform x:Name="Sc"/></Grid.RenderTransform>
                <Border x:Name="On" Background="{DynamicResource AccentSoft}" CornerRadius="12" Opacity="0"/>
                <Border x:Name="B" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" CornerRadius="12"/>
              </Grid>
              <Border BorderThickness="1" Padding="11,3"><ContentPresenter/></Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource AccentLine}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource OnIn}"/></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource OnOut}"/></Trigger.ExitActions></Trigger>
              <Trigger Property="IsPressed" Value="True"><Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource PressIn}"/></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource PressOut}"/></Trigger.ExitActions></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border x:Name="Box" Width="17" Height="17" CornerRadius="5" BorderThickness="1" BorderBrush="{DynamicResource LineStrong}" Background="{DynamicResource Raised}" VerticalAlignment="Top" Margin="0,1,0,0">
                <Path x:Name="Mark" Data="M3.6,8.2 L6.6,11.2 L12.6,4.8" Stroke="{DynamicResource AccentText}" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentLine}"/></Trigger>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource Card}"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="Padding" Value="8,6"/>
    </Style>
    <Style TargetType="ToolTip">
      <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="HasDropShadow" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToolTip">
            <Border Background="{DynamicResource Raised}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" CornerRadius="7" Padding="10,7" MaxWidth="440" Margin="0,0,6,6">
              <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.22" Color="Black"/></Border.Effect>
              <ContentPresenter TextBlock.Foreground="{DynamicResource Text}" TextBlock.FontSize="{StaticResource FsSecondary}">
                <ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></ContentPresenter.Resources>
              </ContentPresenter>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- profile menu -->
    <Style TargetType="ContextMenu">
      <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="HasDropShadow" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border Background="{DynamicResource Raised}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" CornerRadius="9" Padding="5" Margin="0,0,8,8">
              <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.25" Color="Black"/></Border.Effect>
              <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="MenuItem">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Grid>
              <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="11,6" MinWidth="200">
                <DockPanel>
                  <TextBlock x:Name="Arrow" DockPanel.Dock="Right" Text="›" Margin="18,0,0,0" Foreground="{DynamicResource Dim}" Visibility="Collapsed"/>
                  <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                </DockPanel>
              </Border>
              <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="4" VerticalOffset="-6" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                     IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                <Border Background="{DynamicResource Raised}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" CornerRadius="9" Padding="5" Margin="0,0,8,8">
                  <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.25" Color="Black"/></Border.Effect>
                  <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Role" Value="SubmenuHeader"><Setter TargetName="Arrow" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource AccentText}"/><Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource AccentText}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Separator">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Separator"><Border Height="1" Margin="8,5" Background="{DynamicResource Line}"/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- thin overlay-style scroll bars -->
    <Style x:Key="ThumbStyle" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb"><Border x:Name="T" Background="{DynamicResource Thumb}" CornerRadius="4"/>
            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="Background" Value="{DynamicResource ThumbHover}"/></Trigger></ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Width" Value="10"/>
      <Setter Property="MinWidth" Value="10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Border Background="{TemplateBinding Background}">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb><Thumb Style="{StaticResource ThumbStyle}" Margin="2.5"/></Track.Thumb>
              </Track>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="MinWidth" Value="0"/>
          <Setter Property="Height" Value="10"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Border Background="{TemplateBinding Background}">
                  <Track x:Name="PART_Track" IsDirectionReversed="False">
                    <Track.Thumb><Thumb Style="{StaticResource ThumbStyle}" Margin="2.5"/></Track.Thumb>
                  </Track>
                </Border>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/><!-- a card opened to its 하위 lines is tall: whole-card steps jumped past it -->
      <Setter Property="AllowDrop" Value="True"/>
    </Style>
    <Style x:Key="ModItem" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <!-- hover ring and the chosen card's ring + accent wash fade in over the card (layers: theme brushes cannot change colour smoothly) -->
            <Grid>
              <Border BorderThickness="1.5" BorderBrush="Transparent"><ContentPresenter/></Border>
              <Border x:Name="H" BorderThickness="1.5" CornerRadius="11" BorderBrush="{DynamicResource LineStrong}" Opacity="0" IsHitTestVisible="False"/>
              <Border x:Name="On" BorderThickness="1.5" CornerRadius="11" BorderBrush="{DynamicResource Accent}" Background="{DynamicResource AccentSoft}" Opacity="0" IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}"/></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}"/></Trigger.ExitActions></Trigger>
              <Trigger Property="IsSelected" Value="True"><Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource OnIn}"/></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource OnOut}"/></Trigger.ExitActions></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- a card's second line: hidden when there is nothing to say -->
    <Style x:Key="CardSummary" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Sub}"/>
      <Setter Property="FontSize" Value="{StaticResource FsSecondary}"/>
      <Setter Property="Margin" Value="0,5,0,0"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Setter Property="ToolTip" Value="{Binding Summary}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Summary}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
        <DataTrigger Binding="{Binding Summary}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <!-- "접기 N" / "펼치기 N" pill on a card with patches (번역 등) or items: folds the rows below -->
    <Style x:Key="SubToggle" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border Background="{DynamicResource AccentSoft}" CornerRadius="10" Padding="8,1,8,3">
              <StackPanel Orientation="Horizontal">
                <ContentPresenter VerticalAlignment="Center" TextBlock.FontSize="{StaticResource FsCaption}" TextBlock.FontWeight="SemiBold"/>
                <Path x:Name="Arrow" Data="M0,0 L4,4 L8,0" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="6,1,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="False"><Setter TargetName="Arrow" Property="Data" Value="M0,0 L4,4 L0,8"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- one mod: status pill, name, version, kind (coloured text), unsaved / conflict pills, summary, patches inside -->
    <DataTemplate x:Key="ModTemplate">
      <!-- the same 14 px of air at both ends: left of the order number (or of the 끔 badge), right of the last icon (the icon buttons add 4 of their own);
           every gap along the first line is 8 -->
      <Grid>
      <!-- while a card is held: the gap above this card is a drop spot, in that spot's colour; the line where the colour changes is at its top -->
      <Border VerticalAlignment="Top" Height="6" Margin="0,-6,0,0" CornerRadius="3,3,0,0" Background="{Binding GapBrush}" BorderBrush="{Binding EdgeBrush}" BorderThickness="0,3,0,0" IsHitTestVisible="False"/>
      <Border Background="{DynamicResource Card}" CornerRadius="10" BorderThickness="0,3,0,0" BorderBrush="{Binding DropBrush}">
       <Border Background="{Binding ZoneBrush}" BorderBrush="{Binding RingBrush}" BorderThickness="1" CornerRadius="10" Padding="13,7,9,7">   <!-- while a card is held: the colour of the drop spot above this card; a ring when it clashes with the held card -->

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="적용 순서 — 숫자가 클수록(아래일수록) 우선합니다">   <!-- 끔 cards: no number, no gap -->
            <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding OrderText}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
            <TextBlock Text="{Binding OrderPad}" FontSize="{StaticResource FsBody}" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" Visibility="Hidden"/>
            <TextBlock Text="{Binding OrderText}" Foreground="{DynamicResource Dim}" FontSize="{StaticResource FsBody}" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" HorizontalAlignment="Right"/>
          </Grid>
          <StackPanel Grid.Column="1">
            <DockPanel>   <!-- first line; its icons sit at the right end so the lines below keep the full width -->
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0">
                <Button Tag="post" Content="&#xE71B;" ToolTip="{Binding LinkTip}" AutomationProperties.Name="게시글">
                  <Button.Style><Style TargetType="Button" BasedOn="{StaticResource IconBtn}"><Style.Triggers><DataTrigger Binding="{Binding HasLink}" Value="False"><Setter Property="Opacity" Value="0.45"/></DataTrigger></Style.Triggers></Style></Button.Style>
                </Button>
                <Button Style="{StaticResource IconBtn}" Tag="history" Content="&#xE8A5;" ToolTip="패치노트" AutomationProperties.Name="패치노트"/>
              </StackPanel>
              <WrapPanel>
                <Border Background="{Binding BadgeBrush}" CornerRadius="10" Padding="8,1,8,3" VerticalAlignment="Center" ToolTip="{Binding BadgeTip}">
                  <TextBlock Text="{Binding BadgeText}" Foreground="{Binding BadgeFore}" FontSize="{StaticResource FsCaption}" FontWeight="SemiBold"/>
                </Border>
                <TextBlock Text="{Binding Name}" FontSize="{StaticResource FsBody}" FontWeight="Medium" Margin="8,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding VersionText}" Foreground="{DynamicResource Dim}" FontSize="{StaticResource FsSecondary}" Margin="8,1,0,0" VerticalAlignment="Center" ToolTip="모드 버전">
                  <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding VersionText}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding KindText}" Foreground="{Binding KindFore}" FontSize="{StaticResource FsSecondary}" Margin="8,1,0,0" VerticalAlignment="Center" ToolTip="{Binding KindTip}"/>
                <Border Style="{StaticResource Appear}" Background="{DynamicResource WarnSoft}" CornerRadius="10" Padding="8,1,8,3" Margin="8,0,0,0" Visibility="{Binding ChangeVisibility}" VerticalAlignment="Center" ToolTip="{Binding ChangeTip}">
                  <TextBlock Text="{Binding ChangeText}" Foreground="{DynamicResource Warn}" FontSize="{StaticResource FsCaption}" FontWeight="SemiBold"/>
                </Border>
                <Border CornerRadius="10" Padding="8,1,8,3" Margin="8,0,0,0" Visibility="{Binding ConflictVisibility}" VerticalAlignment="Center" ToolTip="{Binding ConflictTip}">
                  <Border.Style><Style TargetType="Border" BasedOn="{StaticResource Appear}"><Setter Property="Background" Value="{DynamicResource BadSoft}"/><Style.Triggers><DataTrigger Binding="{Binding ConflictMild}" Value="True"><Setter Property="Background" Value="{DynamicResource WarnSoft}"/></DataTrigger></Style.Triggers></Style></Border.Style>
                  <TextBlock Text="{Binding ConflictText}" FontSize="{StaticResource FsCaption}" FontWeight="SemiBold">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Bad}"/><Style.Triggers><DataTrigger Binding="{Binding ConflictMild}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Warn}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                  </TextBlock>
                </Border>
                <ToggleButton Style="{StaticResource SubToggle}" Content="{Binding SubCount}" IsChecked="{Binding SubsOpen, Mode=TwoWay}" Visibility="{Binding SubCountVisibility}" Margin="8,0,0,0" VerticalAlignment="Center"
                              ToolTip="이 모드에 딸린 것 — 같은 압축으로 들어간 조각(DLL·데이터·패치), 패치의 항목, 번역 같은 하위 패치. 눌러 접고 펼칩니다. 카드와 함께 움직이고 켜지고 꺼집니다."/>
              </WrapPanel>
            </DockPanel>
            <TextBlock Text="{Binding Summary}" Style="{StaticResource CardSummary}"/>
            <ItemsControl ItemsSource="{Binding Subs}" Visibility="{Binding SubsVisibility}" Margin="0,8,0,0" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource CardAlt}" BorderBrush="{DynamicResource Accent}" BorderThickness="3,0,0,0" CornerRadius="3,8,8,3" Padding="11,6,10,6" Margin="0,0,0,4" ToolTip="{Binding BadgeTip}">
                    <DockPanel>
                      <Border DockPanel.Dock="Right" Background="{Binding BadgeBrush}" CornerRadius="10" Padding="8,1,8,3" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="{Binding BadgeText}" Foreground="{Binding BadgeFore}" FontSize="{StaticResource FsCaption}" FontWeight="SemiBold"/>
                      </Border>
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="{Binding IconsVisibility}">
                        <Button Tag="post" Content="&#xE71B;" ToolTip="{Binding LinkTip}" AutomationProperties.Name="게시글">
                          <Button.Style><Style TargetType="Button" BasedOn="{StaticResource IconBtn}"><Style.Triggers><DataTrigger Binding="{Binding HasLink}" Value="False"><Setter Property="Opacity" Value="0.45"/></DataTrigger></Style.Triggers></Style></Button.Style>
                        </Button>
                        <Button Style="{StaticResource IconBtn}" Tag="history" Content="&#xE8A5;" ToolTip="패치노트" AutomationProperties.Name="패치노트"/>
                      </StackPanel>
                      <CheckBox DockPanel.Dock="Left" IsChecked="{Binding On, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding CheckVisibility}" IsEnabled="{Binding CheckEnabled}" VerticalAlignment="Center" Margin="0,0,8,0" Focusable="False" ToolTip="체크하면 이 항목을 설치하고, 끄면 뺍니다."/>
                      <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                      <TextBlock DockPanel.Dock="Left" Text="{Binding Kind}" Foreground="{Binding KindFore}" Visibility="{Binding KindVisibility}" FontSize="{StaticResource FsSecondary}" Margin="8,1,0,0" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding Info}" Foreground="{DynamicResource Dim}" FontSize="{StaticResource FsSecondary}" Margin="0,1,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <TextBlock Grid.Column="2" Text="{Binding RouteText}" Foreground="{DynamicResource Dim}" FontSize="{StaticResource FsSecondary}" VerticalAlignment="Center" Margin="10,0,0,0" ToolTip="이 DLL을 불러오는 파일 이름(고급 설정에서 바꾼 경우만 표시)">
            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding RouteText}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding RouteText}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>   <!-- empty: no 10px gap after the icons -->
          </TextBlock>
        </Grid>
       </Border>
      </Border>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="DataModTemplate">
      <Border Background="{DynamicResource CardAlt}" CornerRadius="8" Padding="10,6" Margin="0,0,4,4">
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Text="{Binding SelectionText}" Foreground="{Binding SelectionBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
          <StackPanel>
            <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding SourceText}" Foreground="{DynamicResource Dim}" FontSize="{StaticResource FsCaption}" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="PackageTemplate">
      <Border Background="{DynamicResource Card}" CornerRadius="10" Padding="14,10">
        <StackPanel>
          <WrapPanel>
            <Border Background="{Binding BadgeBrush}" CornerRadius="10" Padding="8,1,8,3" VerticalAlignment="Center" ToolTip="{Binding BadgeTip}">
              <TextBlock Text="{Binding BadgeText}" Foreground="{Binding BadgeFore}" FontSize="{StaticResource FsCaption}" FontWeight="SemiBold"/>
            </Border>
            <TextBlock Text="{Binding Name}" FontSize="{StaticResource FsBody}" FontWeight="Medium" Margin="8,0,0,0" VerticalAlignment="Center"/>
          </WrapPanel>
          <TextBlock Text="{Binding Summary}" Style="{StaticResource CardSummary}"/>
          <TextBlock Text="{Binding Warning}" Foreground="{DynamicResource Warn}" Margin="0,3,0,0" TextWrapping="Wrap" Visibility="{Binding WarningVisibility}"/>
        </StackPanel>
      </Border>
    </DataTemplate>
    <!-- section surface -->
    <!-- the recessed box a list of cards sits in, under its panel heading -->
    <Style x:Key="Well" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Well}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="4.5,6"/>   <!-- 4.5 + the card frame 1.5 = 6: the card's edge lands on the text line -->
      <Setter Property="Margin" Value="-6,0"/>   <!-- stands 6 outside the text line, so the cards inside sit on it -->
    </Style>
    <Style x:Key="Surface" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Panel}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="13"/>
    </Style>
    <!-- list headings: plain text in the theme's heading colour -->
    <Style x:Key="Heading" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{StaticResource FsHeadline}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource HeadingText}"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <!-- the name of a list (켜짐 / 꺼짐): the same pill as the badges on its cards (fully round ends), only larger -->
    <Style x:Key="ListTag" TargetType="Border">
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="12,2,12,3"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Sub}"/>
      <Setter Property="FontSize" Value="{StaticResource FsSecondary}"/>
      <Setter Property="LineHeight" Value="19"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource CardAlt}"/>
      <Setter Property="Foreground" Value="{DynamicResource Sub}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="8,8"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>
    <!-- table cells: text centred in the row, long text cut with … and shown whole on hover -->
    <Style TargetType="DataGridCell">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoft}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="BorderBrush" Value="Transparent"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="CellText" TargetType="TextBlock">
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Border x:Name="SkinHead" VerticalAlignment="Top" Visibility="Collapsed" Background="{DynamicResource HeadBg}" IsHitTestVisible="False"/>
    <Border x:Name="SkinEdge" VerticalAlignment="Top" Height="7" Visibility="Collapsed" Background="{DynamicResource MeanderBrush}" IsHitTestVisible="False"/>
    <Border x:Name="SkinFoot" VerticalAlignment="Bottom" Height="7" Visibility="Collapsed" Background="{DynamicResource MeanderBrush}" IsHitTestVisible="False"/>
    <Grid Margin="22,16,22,14">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- 제목 -->
      <DockPanel x:Name="HeaderRow" Grid.Row="0" Margin="0,0,0,14">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="{DynamicResource SegmentBg}" CornerRadius="8" Padding="3">
            <StackPanel Orientation="Horizontal">
              <ToggleButton x:Name="TabMods" Style="{StaticResource Segment}" Content="모드 관리" IsChecked="True" ToolTip="모드를 켜고 끄고, 적용 순서를 정합니다."/>
              <ToggleButton x:Name="TabPackages" Style="{StaticResource Segment}" Content="설치 정보" ToolTip="모드매니저로 설치한 모드를 압축 파일 하나씩 묶어 보여 줍니다. 설명서를 보거나, 그 압축으로 넣은 파일을 통째로 제거할 수 있습니다."/>
              <ToggleButton x:Name="TabInventory" Style="{StaticResource Segment}" Content="전체 목록" ToolTip="게임 폴더·MODs·창작마당을 뒤져, 모드매니저 밖에서 넣은 것까지 깔린 것을 모두 찾아 보여 줍니다. 보기만 하고 파일은 바꾸지 않습니다. 문제가 생겼을 때 확인용입니다."/>
            </StackPanel>
          </Border>
          <Button x:Name="BugButton" Content="버그 제보" Margin="12,0,8,0" ToolTip="디시인사이드의 모드매니저 원글(다운로드 링크가 있는 글)에 댓글로 알려 주세요. 누르면 제보 방법과 게시글 열기가 나옵니다."/>
          <Button x:Name="UpdateButton" Content="업데이트 확인" Margin="0,0,8,0" ToolTip="누르면 각 모드의 디시 게시글 제목에서 버전을 읽어, 지금 쓰는 버전보다 새 버전이 있는지 알려 줍니다. 받기·설치는 게시글에서 직접 하세요(자동으로 받지 않음)."/>
          <Button x:Name="ChooseGame" Content="게임 경로 설정…" Margin="0,0,8,0" ToolTip="영웅입지전이 설치된 LegendOfHeros 폴더(ThreeKingdom.exe 가 있는 곳)를 고릅니다. 보통은 자동으로 찾으니, 게임을 못 찾았거나 다른 드라이브·다른 곳에 설치했을 때 쓰세요."/>
          <Button x:Name="SettingsButtonTop" Margin="0" AutomationProperties.Name="설정" ToolTip="설정 — 화면 크기(글자 크기), 밝기, 강조 색, 스킨, 창 크기 기억, 업데이트 자동 확인">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"/>
              <TextBlock Text="설정" Margin="6,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>
        <StackPanel VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="모드매니저" FontSize="{StaticResource FsDisplay}" FontWeight="Bold" Foreground="{DynamicResource HeadText}"/>
            <TextBlock x:Name="VersionLabel" Text="0.11.3" Foreground="{DynamicResource HeadSub}" FontSize="{StaticResource FsSecondary}" Margin="10,0,0,4" VerticalAlignment="Bottom" Cursor="Hand" AutomationProperties.Name="모드매니저 패치노트"/>
          </StackPanel>
          <TextBlock x:Name="GamePath" Style="{StaticResource Caption}" Foreground="{DynamicResource HeadSub}" Margin="1,3,0,0" TextTrimming="CharacterEllipsis" Cursor="Hand" ToolTip="게임 설치 경로 — 누르면 탐색기로 엽니다. 바꾸려면 오른쪽 위 '게임 경로 설정…'"/>
        </StackPanel>
      </DockPanel>

      <!-- 게임 상태 띠. Every panel's text starts on one line, 20 from its edge; the state dot stands on it, like the 켜짐 tag -->
      <Border Grid.Row="1" Style="{StaticResource Surface}" Padding="20,12">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="LaunchButton" Content="게임 실행" ToolTip="Steam으로 게임을 켭니다 (F9)" Style="{StaticResource PrimaryBtn}" FontWeight="SemiBold" Padding="18,6"/>
            <Button x:Name="ProfileButton" Content="프로필" ToolTip="지금 켜 둔 모드와 순서를 이름 붙여 저장해 두고, 나중에 한 번에 불러옵니다. 코드로 다른 PC와 주고받을 수도 있습니다."/>
            <Button x:Name="RefreshButton" Content="새로고침" ToolTip="모드 목록과 게임 상태를 다시 읽습니다 (F5)"/>
            <Button x:Name="RevertButton" Content="되돌리기" Visibility="Collapsed" ToolTip="저장하지 않은 변경을 모두 취소하고, 마지막으로 저장한 상태로 돌아갑니다."/>
            <Button x:Name="SaveButton" Content="저장" Padding="20,6" Margin="0" FontWeight="SemiBold"/>
          </StackPanel>
          <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="GameDot" Width="9" Height="9" Fill="{DynamicResource Dim}" VerticalAlignment="Center" Margin="0,1,8,0"/>
              <TextBlock x:Name="GameText" Text="게임 상태 확인 중" FontSize="{StaticResource FsHeadline}" FontWeight="SemiBold"/>
              <TextBlock x:Name="ChangeCount" Foreground="{DynamicResource Warn}" FontWeight="SemiBold" Margin="14,1,0,0"/>
              <TextBlock x:Name="LoadingText" Foreground="{DynamicResource Dim}" Margin="14,1,0,0"/>
            </StackPanel>
            <TextBlock x:Name="GameSub" Foreground="{DynamicResource Sub}" FontSize="{StaticResource FsSecondary}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- 안내(예약·적용 결과·오류) -->
      <Border x:Name="Notice" Grid.Row="2" Style="{StaticResource Appear}" Visibility="Collapsed" CornerRadius="11" Padding="20,10" Margin="0,10,0,0" BorderThickness="1">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button x:Name="NoticeAction1" Visibility="Collapsed"/>
            <Button x:Name="NoticeAction2" Visibility="Collapsed"/>
            <Button x:Name="NoticeClose" Content="닫기" Margin="0"/>
          </StackPanel>
          <TextBlock x:Name="NoticeText" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>

      <!-- 알림(충돌·오류) -->
      <StackPanel Grid.Row="3" Margin="0,8,0,0">
        <ToggleButton x:Name="AlertsToggle" Style="{StaticResource Tab}" HorizontalAlignment="Left" Visibility="Collapsed"/>
        <ItemsControl x:Name="Alerts" Style="{StaticResource Appear}" Visibility="Collapsed" Margin="0,6,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" TextWrapping="Wrap" Margin="2,1"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- 모드 화면 -->
      <Grid x:Name="ModsView" Grid.Row="4" Margin="0,8,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" MinHeight="240"/>
          <RowDefinition x:Name="DetailRowDef" Height="190" MinHeight="165"/>   <!-- the user drags the bar above it; remembered -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="ActivePanel" Grid.Column="0" Style="{StaticResource Surface}" Padding="20,14,20,14">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
              <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource ListTag}" Background="{DynamicResource AccentSoft}"><TextBlock Text="켜짐" Style="{StaticResource Heading}" Foreground="{DynamicResource Accent}"/></Border>
                <TextBlock x:Name="ActiveCount" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="9,0,0,0"/>
              </StackPanel>
              <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" Text="게임을 켜면 자동으로 적용됩니다. 위에서부터 차례로 적용되고, 같은 부분을 바꾸는 모드끼리는 아래쪽이 우선합니다. 순서는 카드를 끌어서 바꿉니다."
                           ToolTip="드래그하는 중에 휠을 굴리거나 목록 위·아래 끝으로 가져가면 목록이 스크롤됩니다. 끄려면 오른쪽 목록으로, 지우려면 아래 칸으로 드래그하세요. Esc 를 누르면 취소됩니다."/>
            </StackPanel>
            <Grid x:Name="DropHint" DockPanel.Dock="Bottom" Margin="-6,10,-6,0" MinHeight="62">
              <Rectangle Stroke="{DynamicResource Accent}" StrokeThickness="1.5" StrokeDashArray="5 3" RadiusX="10" RadiusY="10" Fill="{DynamicResource AccentSoft}"/>
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12,8">
                <TextBlock Text="＋ 새 모드 설치" FontSize="{StaticResource FsHeadline}" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
                <TextBlock Text="받은 압축 파일(zip·7z·rar)을 마우스로 끌어 이 창에 놓으세요" FontSize="{StaticResource FsSecondary}" Foreground="{DynamicResource Sub}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,2,0,0"/>
              </StackPanel>
            </Grid>
            <Border Style="{StaticResource Well}"><DockPanel>
            <Grid>
              <!-- while a card is held: the whole list's zones, in the scrollbar's track behind its thumb -->
              <Border x:Name="ActiveRail" HorizontalAlignment="Right" Width="5" Margin="0,2.5,2.5,2.5" CornerRadius="2.5" Visibility="Collapsed" IsHitTestVisible="False"/>
              <ListBox x:Name="ActiveList" ItemTemplate="{StaticResource ModTemplate}">
                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource ModItem}"><Setter Property="Margin" Value="{Binding CardMargin}"/></Style></ListBox.ItemContainerStyle>   <!-- while a card is held: room under the last card, inside the scrolling -->
              </ListBox>
              <TextBlock x:Name="ActiveEmpty" Text="켜 둔 모드가 없습니다.&#10;오른쪽 목록에서 두 번 클릭하거나, 모드 압축 파일을 이 창으로 드래그하세요." Foreground="{DynamicResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="18,0" IsHitTestVisible="False"/>
              <!-- while a card is held: the spot under the last card, the same line as on a card's top, and what is left below it in that spot's colour -->
              <Canvas x:Name="ActiveEndLayer" ClipToBounds="True" Visibility="Collapsed" IsHitTestVisible="False"><Border x:Name="ActiveEnd" CornerRadius="3,3,0,0" BorderThickness="0,3,0,0" BorderBrush="Transparent"/></Canvas>
            </Grid>
            </DockPanel></Border>
          </DockPanel>
        </Border>

        <!-- shrinks (only) when the window is too short for the whole column -->
        <Viewbox Grid.Column="1" VerticalAlignment="Center" Margin="12,0" StretchDirection="DownOnly"><StackPanel Width="108">
          <Border Style="{StaticResource RailGroup}" Margin="0"><StackPanel Grid.IsSharedSizeScope="True">
            <Button x:Name="EnableButton" Style="{StaticResource RailBtn}" Tag="&#xE72B;" Content="켜기" ToolTip="오른쪽 목록에서 고른 모드를 켭니다 (Enter · 두 번 클릭)"/>
            <Border Style="{StaticResource RailSplit}"/>
            <Button x:Name="DisableButton" Style="{StaticResource RailBtn}" Tag="&#xE72A;" Content="끄기" ToolTip="왼쪽 목록에서 고른 모드를 끕니다 (Enter · 두 번 클릭)"/>
          </StackPanel></Border>
          <Border Style="{StaticResource RailGroup}" Margin="0,12,0,0"><StackPanel Grid.IsSharedSizeScope="True">
            <Button x:Name="UpButton" Style="{StaticResource RailBtn}" Tag="&#xE74A;" Content="위로" ToolTip="고른 모드를 한 칸 위로 옮깁니다 (Alt+↑)"/>
            <Border Style="{StaticResource RailSplit}"/>
            <Button x:Name="DownButton" Style="{StaticResource RailBtn}" Tag="&#xE74B;" Content="아래로" ToolTip="고른 모드를 한 칸 아래로 옮깁니다 (Alt+↓)"/>
          </StackPanel></Border>
          <Border Style="{StaticResource RailGroup}" Margin="0,12,0,0"><StackPanel Grid.IsSharedSizeScope="True">
            <Button x:Name="SortButton" Style="{StaticResource RailBtn}" Tag="&#xE8CB;" Content="자동 정렬" ToolTip="패치·번역은 원본 아래로, 메뉴 조건 파일이 없는 모드는 그 파일이 있는 모드 위로, 게임 파일 패치는 맨 위에 모아 들어가는 순서로 둡니다. 저장해야 적용됩니다."/>
          </StackPanel></Border>
          <Border Style="{StaticResource RailGroup}" Margin="0,28,0,0"><StackPanel Grid.IsSharedSizeScope="True">
            <Button x:Name="AllOffButton" Style="{StaticResource RailBtn}" Tag="&#xE7E8;" Content="모두 끄기" ToolTip="모든 모드를 오른쪽(꺼짐) 목록으로 옮깁니다. 저장해야 적용되며, 저장하기 전이면 '되돌리기'로 취소할 수 있습니다."/>
          </StackPanel></Border>
        </StackPanel></Viewbox>

        <Border x:Name="InactivePanel" Grid.Column="2" Style="{StaticResource Surface}" Padding="20,14,20,14">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition x:Name="DataRow" Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,12">
              <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource ListTag}" Background="{DynamicResource Neutral}"><TextBlock Text="꺼짐" Style="{StaticResource Heading}" Foreground="{DynamicResource Text2}"/></Border>
                <TextBlock x:Name="InactiveCount" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="9,0,0,0"/>
              </StackPanel>
              <TextBlock Text="설치되어 있지만 게임에 적용하지 않습니다. 두 번 클릭하거나 왼쪽 목록으로 드래그하면 켭니다." Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <Border Style="{StaticResource Well}" Grid.Row="1">
            <Grid>
              <ListBox x:Name="InactiveList" ItemTemplate="{StaticResource ModTemplate}" ItemContainerStyle="{StaticResource ModItem}"/>
              <TextBlock x:Name="InactiveEmpty" Text="꺼 둔 모드가 없습니다." Foreground="{DynamicResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="18,0" IsHitTestVisible="False"/>
            </Grid>
            </Border>
            <ToggleButton x:Name="DataToggle" Grid.Row="2" Style="{StaticResource Tab}" HorizontalAlignment="Left" Margin="0,8,0,0" Content="데이터 모드 보기"/>
            <ListBox x:Name="DataList" Grid.Row="3" ItemTemplate="{StaticResource DataModTemplate}" MaxHeight="210" Margin="0,8,0,0" Visibility="Collapsed" AllowDrop="False"/>
          </Grid>
        </Border>

        <!-- 고른 모드 자세히 -->
        <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Surface}" Padding="20,12" Margin="0,10,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="DetailBody" Margin="0,0,8,0">
              <TextBlock x:Name="DetailTitle" Text="모드를 고르면 자세한 내용이 여기에 나옵니다." FontSize="{StaticResource FsHeadline}" FontWeight="SemiBold"/>
              <TextBlock x:Name="DetailStatus" Foreground="{DynamicResource Text2}" TextWrapping="Wrap" Margin="0,5,0,0"/>
              <!-- 하위 패치(창작마당 원본 카드를 고르면): 게시글 · 다시 적용 · 패치 제거 — 위쪽에 두어 작은 칸에서도 보임 -->
              <StackPanel x:Name="SubPanel" Margin="0,8,0,2" Visibility="Collapsed"/>
              <TextBlock x:Name="DetailInfo" Foreground="{DynamicResource Sub}" TextWrapping="Wrap" Margin="0,4,0,0"/>
              <TextBlock x:Name="DetailTech" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
              <StackPanel x:Name="AdvancedPanel" Visibility="Collapsed" Margin="0,10,0,0">
                <DockPanel Margin="0,0,0,10">
                  <Button x:Name="LinkButton" DockPanel.Dock="Right" Content="게시글 링크 바꾸기…" Margin="10,0,0,0" ToolTip="이 모드의 게시글(디시 글 등) 주소를 적거나 바꿉니다. 비우면 링크를 지웁니다."/>
                  <TextBlock x:Name="PostLinkText" Foreground="{DynamicResource Sub}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </DockPanel>
                <StackPanel x:Name="RoutePanel">
                  <TextBlock Text="불러오는 방식 — 게임이 이 DLL을 어떤 파일을 거쳐 불러올지 정합니다. 보통은 version.dll 그대로 두세요." Foreground="{DynamicResource Sub}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                  <StackPanel x:Name="RouteChips" Orientation="Horizontal"/>
                  <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="LocateButton" Content="DLL 파일 다시 지정…" ToolTip="이 모드의 DLL 파일을 다른 곳으로 옮겼을 때, 새 위치의 파일을 골라 줍니다."/>
                    <Button x:Name="UnregisterButton" Content="목록에서 빼기" ToolTip="'DLL 파일 추가'로 넣은 모드를 목록에서 뺍니다. DLL 파일 자체는 지우지 않습니다. 저장해야 적용됩니다."/>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </StackPanel></ScrollViewer>
            <!-- fixed slots: a button keeps its place (greyed out when it does not apply), so the text on the left keeps its width -->
            <StackPanel x:Name="DetailButtons" Grid.Column="1" Margin="16,0,0,0" Width="480" VerticalAlignment="Top">
              <UniformGrid Columns="4">
                <Button x:Name="OpenFolder" Content="폴더 열기" ToolTip="이 모드가 들어 있는 폴더를 탐색기로 엽니다." Margin="0,0,8,8"/>
                <Button x:Name="OpenLog" Content="로그 열기" ToolTip="이 모드가 남긴 기록(로그)을 메모장으로 엽니다. 모드가 제대로 안 될 때 확인하세요." Margin="0,0,8,8"/>
                <Button x:Name="SettingsButton" Content="설정 열기" Margin="0,0,8,8"/>
                <ToggleButton x:Name="AdvancedToggle" Style="{StaticResource Tab}" Content="고급 설정" ToolTip="게시글 링크, 불러오는 방식, DLL 파일 위치처럼 평소에는 바꿀 일이 없는 설정입니다." Margin="0,0,0,8"/>
                <Button x:Name="RemoveButton" ToolTip="고른 모드를 삭제합니다. 지우기 전에 백업해 두므로 '설치 정보' 탭의 '지운 모드 되살리기'로 되돌릴 수 있습니다. 카드를 이 칸으로 드래그해도 됩니다." Margin="0,0,0,8"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,1,7,0"/><TextBlock Text="삭제…" VerticalAlignment="Center"/></StackPanel></Button>
              </UniformGrid>
              <!-- only when they apply: mods that cannot run together, a DLL that sits in the game folder -->
              <WrapPanel HorizontalAlignment="Right">
                <Button x:Name="EntryButton" Content="모드매니저로 함께 실행" Margin="0,0,8,8" Visibility="Collapsed"/>
                <Button x:Name="OffOthersButton" Content="겹치는 모드 끄기" Margin="0,0,8,8" Visibility="Collapsed" ToolTip="이 모드와 함께 쓸 수 없는 모드를 끕니다. 저장해야 적용됩니다."/>
              </WrapPanel>
            </StackPanel>
          </Grid>
        </Border>
        <!-- the bar between the lists and the details: drag to give either more room -->
        <GridSplitter x:Name="DetailSplitter" Grid.Row="1" Grid.ColumnSpan="3" VerticalAlignment="Top" HorizontalAlignment="Stretch" Height="10" ResizeDirection="Rows" ResizeBehavior="PreviousAndCurrent" Cursor="SizeNS" Focusable="False">
          <GridSplitter.Template><ControlTemplate TargetType="GridSplitter"><Border Background="Transparent"><Border x:Name="Grip" Width="44" Height="4" CornerRadius="2" Background="{DynamicResource BtnLine}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></GridSplitter.Template>
        </GridSplitter>
        <!-- 카드를 드래그하는 동안만 아래 칸을 덮는 삭제 자리 -->
        <Border x:Name="TrashZone" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0" Visibility="Collapsed" CornerRadius="13" BorderThickness="2"
                BorderBrush="{DynamicResource BadLine}" Background="{DynamicResource Raised}">   <!-- opaque: in 수묵 the panels are see-through and the text below showed through -->
          <Grid>
          <Border x:Name="TrashTint" CornerRadius="11" Background="Transparent"/>   <!-- the red tint while a card is over it, on the opaque base -->
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="TrashText" Text="🗑 여기에 놓으면 삭제합니다" Foreground="{DynamicResource Bad}" FontSize="{StaticResource FsTitle}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="지우기 전에 백업해 두므로 '설치 정보' 탭의 '지운 모드 되살리기'로 되돌릴 수 있습니다." Style="{StaticResource Caption}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
          </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <!-- 설치 정보 화면(관리창으로 설치한 압축 하나 = 한 묶음) -->
      <Grid x:Name="PackagesView" Grid.Row="4" Margin="0,8,0,0" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="5*"/>
          <ColumnDefinition Width="6*"/>
        </Grid.ColumnDefinitions>
        <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,10">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="PatchRebuild" Content="패치 다시 적용" Visibility="Collapsed" ToolTip="올인원 패처·창천UI처럼 게임 본체 파일(GameAssembly.dll)을 고치는 패치를, 보관해 둔 원본 파일에 지금 순서대로 다시 적용합니다. 보통은 모드매니저가 알아서 하므로, 패치가 풀린 것 같을 때만 누르세요(패치에 따라 시간이 걸릴 수 있습니다)."/>
            <Button x:Name="RestoreButton" Content="지운 모드 되살리기" Margin="0" ToolTip="모드매니저에서 지운 모드를 백업에서 되돌립니다."/>
          </StackPanel>
          <StackPanel>
            <TextBlock Text="모드매니저로 설치한 모드를 압축 파일 하나씩 묶어 보여 줍니다. 제거하면 그 압축으로 넣은 파일을 모두 빼고, 덮어썼던 게임 원본 파일은 되돌립니다." Foreground="{DynamicResource Text2}" TextWrapping="Wrap"/>
            <TextBlock Text="새 모드는 압축 파일(zip·7z·rar)이나 압축을 푼 폴더를 이 창으로 드래그하면 설치됩니다. 압축 안의 설치 프로그램(.bat·.exe·.py)은 실행하지 않습니다." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0"/>
          </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Style="{StaticResource Surface}" Padding="20,14,20,14">
          <Grid>
            <ListBox x:Name="PackageList" ItemTemplate="{StaticResource PackageTemplate}" ItemContainerStyle="{StaticResource ModItem}"/>
            <TextBlock x:Name="PackagesEmpty" Text="모드매니저로 설치한 모드가 없습니다.&#10;모드 압축 파일을 이 창으로 드래그해 보세요." TextAlignment="Center" TextWrapping="Wrap" Margin="18,0" Foreground="{DynamicResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
          </Grid>
        </Border>
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Surface}" Padding="20,12" Margin="10,0,0,0">
          <DockPanel>
            <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,10,0,0">
              <Button x:Name="PackageUninstall" Content="제거…" Margin="0" ToolTip="이 압축으로 넣은 파일을 모두 빼고, 덮어썼던 게임 원본 파일은 되돌립니다. 뺀 파일은 보관함에 남겨 '지운 모드 되살리기'로 되돌릴 수 있습니다."/>
            </WrapPanel>
            <StackPanel DockPanel.Dock="Top">
              <TextBlock x:Name="PackageTitle" Text="목록에서 모드를 고르면 자세한 내용과 설명서가 여기에 나옵니다." FontSize="{StaticResource FsHeadline}" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <TextBlock x:Name="PackageInfo" Foreground="{DynamicResource Sub}" TextWrapping="Wrap" Margin="0,6,0,0"/>
              <TextBlock x:Name="PackageDocName" Style="{StaticResource Caption}" Margin="0,10,0,4"/>
            </StackPanel>
            <TextBox x:Name="PackageDoc" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Foreground="{DynamicResource Text2}"/>
          </DockPanel>
        </Border>
      </Grid>

      <!-- 전체 목록 화면 -->
      <Grid x:Name="InventoryView" Grid.Row="4" Margin="0,8,0,0" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,10">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button x:Name="RegisterButton" Content="모드 목록에 추가" ToolTip="고른 DLL을 '모드 관리' 탭 목록에 추가해 켜고 끌 수 있게 합니다. 파일은 그 자리에 그대로 둡니다."/>
            <Button x:Name="InventoryRemove" Content="백업하고 제거…" Margin="0" ToolTip="고른 항목을 백업한 뒤 게임에서 뺍니다. '설치 정보' 탭의 '지운 모드 되살리기'로 되돌릴 수 있습니다."/>
          </StackPanel>
          <TextBlock Text="게임 폴더·MODs·창작마당에 설치된 것을 모두 찾아 보여 줍니다. 보기만 하며 파일은 바꾸지 않습니다. 줄을 고르면 아래에 자세한 내용이 나옵니다." Foreground="{DynamicResource Sub}" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
        <Border Grid.Row="1" Style="{StaticResource Surface}" Padding="1" ClipToBounds="True">
          <DataGrid x:Name="InventoryGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single"
                    Background="Transparent" RowBackground="{DynamicResource Card}" AlternatingRowBackground="{DynamicResource CardAlt}" Foreground="{DynamicResource Text}"
                    BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource Line}" RowHeight="36" CanUserResizeRows="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="2*" ElementStyle="{StaticResource CellText}"/>
              <DataGridTextColumn Header="어디서 왔나" Binding="{Binding Source}" Width="1.1*" ElementStyle="{StaticResource CellText}"/>
              <DataGridTextColumn Header="종류" Binding="{Binding Type}" Width="1.5*" ElementStyle="{StaticResource CellText}"/>
              <DataGridTextColumn Header="적용 방식" Binding="{Binding Method}" Width="1.5*" ElementStyle="{StaticResource CellText}"/>
              <DataGridTextColumn Header="불러오는 곳" Binding="{Binding Entry}" Width="1.6*" ElementStyle="{StaticResource CellText}"/>
              <DataGridTextColumn Header="상태" Binding="{Binding State}" Width="2.2*" ElementStyle="{StaticResource CellText}"/>
            </DataGrid.Columns>
          </DataGrid>
        </Border>
        <TextBlock x:Name="InventoryDetail" Grid.Row="2" Foreground="{DynamicResource Sub}" TextWrapping="Wrap" Margin="2,8,0,0"/>
      </Grid>
    </Grid>

    <!-- 끌고 있는 모드 카드(포인터를 따라다니는 사진) -->
    <Canvas x:Name="DragLayer" IsHitTestVisible="False">
      <Rectangle x:Name="DragGhost" Visibility="Collapsed" Opacity="0.88" RadiusX="11" RadiusY="11">
        <Rectangle.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.35" Color="Black"/></Rectangle.Effect>
      </Rectangle>
      <!-- 잡은 카드 위: 이 자리에 놓으면 어떻게 되는지 색과 한 줄로 -->
      <Border x:Name="DragResult" Visibility="Collapsed" CornerRadius="11" BorderThickness="1.5">
        <Border x:Name="DragResultBack" Background="{DynamicResource Card}" CornerRadius="10" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
          <Border x:Name="DragResultPill" CornerRadius="10" Padding="8,1,8,3">
            <TextBlock x:Name="DragResultText" FontSize="{StaticResource FsCaption}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          </Border>
        </Border>
      </Border>
    </Canvas>

    <!-- 압축·폴더를 끌어 오면 보이는 안내(놓으면 설치 미리보기) -->
    <Border x:Name="DropLayer" Visibility="Collapsed" Background="Transparent" AllowDrop="True">
      <Canvas x:Name="DropCanvas" IsHitTestVisible="False">
        <Border x:Name="DropOn" CornerRadius="12" BorderThickness="2" BorderBrush="{DynamicResource Accent}" Background="{DynamicResource AccentSoft}">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" MaxWidth="460">
            <TextBlock Text="여기에 놓으면 켠 채로 설치합니다" FontSize="{StaticResource FsTitle}" FontWeight="Bold" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
            <TextBlock Text="켜짐 목록 맨 아래에 들어가요. 맨 아래가 가장 나중에 적용되어, 겹치는 부분은 이 모드가 우선합니다. 저장하면 게임에 반영됩니다." FontSize="{StaticResource FsBody}" Foreground="{DynamicResource Sub}" Margin="0,10,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
          </StackPanel>
        </Border>
        <Border x:Name="DropOff" CornerRadius="12" BorderThickness="2" BorderBrush="{DynamicResource Accent}" Background="{DynamicResource AccentSoft}">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" MaxWidth="460">
            <TextBlock Text="여기에 놓으면 꺼 둔 채 설치합니다" FontSize="{StaticResource FsTitle}" FontWeight="Bold" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
            <TextBlock Text="꺼짐 목록 맨 아래에 들어가요. 쓰고 싶을 때 왼쪽으로 옮기면 됩니다." FontSize="{StaticResource FsBody}" Foreground="{DynamicResource Sub}" Margin="0,10,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
          </StackPanel>
        </Border>
      </Canvas>
    </Border>

    <Border x:Name="Busy" Visibility="Collapsed" Background="{DynamicResource Overlay}">
      <Border Style="{StaticResource Surface}" Background="{DynamicResource Raised}" Padding="28,22" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.25" Color="Black"/></Border.Effect>
        <StackPanel>
          <TextBlock x:Name="BusyText" Text="처리 중…" FontSize="{StaticResource FsTitle}" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="560" TextAlignment="Center"/>
          <ProgressBar IsIndeterminate="True" Width="280" Height="4" Margin="0,14,0,0" Foreground="{DynamicResource Accent}" Background="{DynamicResource Neutral}" BorderThickness="0"/>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
